#!/usr/bin/env bash
#MISE description="Regenerate docs/llms-full.txt from the individual doc pages"
#MISE sources=["docs/index.md", "docs/usage.md", "docs/templates.md", "docs/creating-templates.md"]
#MISE outputs=["docs/llms-full.txt"]
set -euo pipefail

DOCS_DIR="docs"
OUTPUT="$DOCS_DIR/llms-full.txt"

PAGES=(
    index.md
    usage.md
    templates.md
    creating-templates.md
)

{
    echo "# gohatch — Full Documentation"
    echo ""
    echo "> Complete documentation for gohatch, a project scaffolding tool for Go."
    echo ""

    for file in "${PAGES[@]}"; do
        path="$DOCS_DIR/$file"
        if [[ ! -f $path ]]; then
            echo "missing page: $path" >&2
            exit 1
        fi
        echo "---"
        echo ""
        cat "$path"
        echo ""
    done
} > "$OUTPUT"

wc -l < "$OUTPUT" | xargs printf "Generated %s (%s lines)\n" "$OUTPUT"
